# Application
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_TO_FILE=true

# LLM
MODEL_NAME=google_genai:gemini-2.5-flash-lite
GOOGLE_API_KEY=
# Optional: comma-separated keys to rotate across (round-robin) to spread
# quota usage. Takes precedence over GOOGLE_API_KEY when set.
GOOGLE_API_KEYS=

# AI Interviewer
INTERVIEW_MODEL_NAME=google_genai:gemini-3.5-flash-lite
# Optional: dedicated key so interviews don't share the scorers' quota or
# circuit breaker. Falls back to the rotated GOOGLE_API_KEYS pool when unset.
INTERVIEW_GOOGLE_API_KEY=

# Core questions per interview, and the accepted spread when validating the
# generated script.
INTERVIEW_QUESTION_COUNT=5
INTERVIEW_QUESTION_COUNT_TOLERANCE=1

# How candidates answer: "audio" (spoken, transcribed by the interview model)
# or "text" (typed).
# Production values must be seeded into SSM Parameter Store (make seed-ssm)
# BEFORE a deploy: config is rendered from SSM, so an unseeded var silently
# runs the code default ("text") with no error anywhere.
INTERVIEW_MODE=audio

# Whether the interviewer's questions are read aloud to the candidate: "on" or
# "off". Independent of INTERVIEW_MODE -- synthesis is the most expensive call
# in the pipeline, so spoken questions and spoken answers are priced and
# switched separately. Same SSM-seeding warning as above; the code default is
# "off", so an unseeded deploy runs silently voiceless.
INTERVIEW_VOICE=on
# Must end in "-tts". No voice/timbre setting exists: langchain-google-genai
# cannot carry speech_config, so the model's default voice is what ships.
INTERVIEW_TTS_MODEL_NAME=google_genai:gemini-2.5-flash-preview-tts

# LLM rate limiting
#
# "on" enforces, "log" counts and logs without rejecting, "off" skips Redis entirely.
RATE_LIMIT_ENABLED=on
# Ceiling across ALL callers per UTC day, in LLM work units (1 resume = 1 unit,
# 1 JD parse = 1, 1 spoken interview answer = 2).
RATE_LIMIT_DAILY_GLOBAL_UNITS=100

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruit-ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Email: "console", "gmail", or "resend"
EMAIL_PROVIDER=console

# Gmail SMTP (enable 2FA, then create app password)
MAIL_FROM=
MAIL_PASSWORD=
MAIL_FROM_NAME=Recruit AI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Resend (uncomment when using resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Recruit AI <noreply@yourdomain.com>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
SECRET_KEY=random-secret-key

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Storage (Required if USE_S3=true)
USE_S3=false
S3_BUCKET_NAME=recruit-ai
S3_REGION=us-east-1
