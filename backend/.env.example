# =============================================================================
# Required
# =============================================================================
# Signs JWTs and the OAuth session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Host ports from docker compose (5433 / 6380). Containers override both.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/recruit-ai
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# App
# =============================================================================
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_TO_FILE=false

# =============================================================================
# Auth (Google OAuth)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# LLM providers
# =============================================================================
# Required unless GOOGLE_API_KEYS is set.
GOOGLE_API_KEY=
# Optional: comma-separated keys rotated round-robin to spread quota usage.
# Overrides GOOGLE_API_KEY when set.
GOOGLE_API_KEYS=

# Optional: Meta Model API (Muse Spark). Enables "meta:<model>" values in the
# LLM models section, e.g. meta:muse-spark-1.3-contributor (the contributor
# tier is cheap because Meta may train on prompts and outputs).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# =============================================================================
# LLM models
# =============================================================================
# Text models (MODEL_NAME, INTERVIEW_MODEL_NAME) may be Gemini or meta:.
# Transcription and TTS must stay Gemini: Muse Spark has no audio input or TTS.
MODEL_NAME=google_genai:gemini-2.5-flash-lite
INTERVIEW_MODEL_NAME=google_genai:gemini-3.5-flash-lite
# Spoken-answer transcription. Must accept audio input.
INTERVIEW_TRANSCRIBE_MODEL_NAME=google_genai:gemini-3.5-flash-lite
# Must end in "-tts". No voice/timbre setting exists: langchain-google-genai
# cannot carry speech_config, so the model's default voice is what ships.
INTERVIEW_TTS_MODEL_NAME=google_genai:gemini-2.5-flash-preview-tts

# =============================================================================
# AI interviewer
# =============================================================================
# How candidates answer: "audio" (spoken, transcribed) or "text" (typed).
# Code default is "text".
INTERVIEW_MODE=audio
# Whether questions are read aloud: "on" or "off". Independent of
# INTERVIEW_MODE because synthesis is the most expensive call in the pipeline,
# so spoken questions and spoken answers are priced and switched separately.
# Code default is "off".
INTERVIEW_VOICE=on
# Core questions per interview, and the accepted spread when validating the
# generated script.
INTERVIEW_QUESTION_COUNT=5
INTERVIEW_QUESTION_COUNT_TOLERANCE=1

# =============================================================================
# LLM rate limiting
# =============================================================================
# "on" enforces, "log" counts and logs without rejecting, "off" skips Redis entirely.
RATE_LIMIT_ENABLED=on
# Ceiling across ALL callers per UTC day, in LLM work units (1 resume = 1 unit,
# 1 JD parse = 1, 1 spoken interview answer = 2).
RATE_LIMIT_DAILY_GLOBAL_UNITS=100

# =============================================================================
# LLM tracing (LangSmith)
# =============================================================================
# Optional. Read by LangChain directly, not by app config.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recruit-ai
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# =============================================================================
# Email
# =============================================================================
# "console" (logs to stdout), "gmail", or "resend". Uncomment the matching block.
EMAIL_PROVIDER=console

# Gmail SMTP (enable 2FA, then create an app password)
# MAIL_FROM=
# MAIL_PASSWORD=
# MAIL_FROM_NAME=Recruit AI
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587

# Resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Recruit AI <noreply@yourdomain.com>

# =============================================================================
# Storage
# =============================================================================
# Local disk when false. The rest of this section is only read when true.
USE_S3=false
S3_BUCKET_NAME=recruit-ai
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
