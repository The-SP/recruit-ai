# Application
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# API Key Authentication (leave empty to disable)
API_KEY=

# Logging
LOG_TO_FILE=true

# LLM
MODEL_NAME=google_genai:gemini-2.5-flash-lite
GOOGLE_API_KEY=
# Optional: comma-separated keys to rotate across (round-robin) to spread
# quota usage. Takes precedence over GOOGLE_API_KEY when set.
GOOGLE_API_KEYS=

# AI Interviewer
INTERVIEW_MODEL_NAME=google_genai:gemini-3.5-flash-lite
# Optional: dedicated key so interviews don't share the scorers' quota or
# circuit breaker. Falls back to the rotated GOOGLE_API_KEYS pool when unset.
INTERVIEW_GOOGLE_API_KEY=

# Core questions per interview, and the accepted spread when validating the
# generated script.
INTERVIEW_QUESTION_COUNT=5
INTERVIEW_QUESTION_COUNT_TOLERANCE=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruit-ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Email: "console", "gmail", or "resend"
EMAIL_PROVIDER=console

# Gmail SMTP (enable 2FA, then create app password)
MAIL_FROM=
MAIL_PASSWORD=
MAIL_FROM_NAME=Recruit AI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Resend (uncomment when using resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Recruit AI <noreply@yourdomain.com>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
SECRET_KEY=random-secret-key

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Storage (Required if USE_S3=true)
USE_S3=false
S3_BUCKET_NAME=recruit-ai
S3_REGION=us-east-1
