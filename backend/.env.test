# Loaded by tests/conftest.py with override=True. No real secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test-recruit-ai
# Unreachable on purpose: tests use fakeredis.
REDIS_URL=redis://unused-in-tests:6379/0
SECRET_KEY=test-secret-key-that-is-long-enough-for-hs256
EMAIL_PROVIDER=console
LANGSMITH_TRACING=false
LOG_TO_FILE=false

# Blank on purpose: a set-but-empty var stops config.py's load_dotenv() from
# filling in real keys from a developer's .env.
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
META_API_KEY=
LANGSMITH_API_KEY=

# Tests assert against these. The 429 tests assume a 100-unit ceiling.
RATE_LIMIT_ENABLED=on
RATE_LIMIT_DAILY_GLOBAL_UNITS=100
USE_S3=false
INTERVIEW_MODE=text
INTERVIEW_VOICE=off
